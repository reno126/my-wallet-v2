{
  "name": "my-wallet-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^22.22.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @my-wallets/web dev",
    "dev:workspace": "pnpm --recursive --parallel --if-present dev",
    "dev:local": "dotenv -e .env.local -- pnpm dev:workspace",
    "ci:workspace": "pnpm run contracts:check && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run test:eslint-rules && pnpm run test:database-safety && pnpm run build && pnpm run test:deployment && pnpm run audit",
    "ci:local": "dotenv -e .env.ci.local -- pnpm ci:workspace",
    "test": "pnpm --recursive --workspace-concurrency=1 --if-present test",
    "test:e2e": "pnpm --filter @my-wallets/e2e test",
    "test:deployment": "pnpm --filter @my-wallets/e2e test:deployment",
    "test:preview": "pnpm --filter @my-wallets/e2e test:preview",
    "build": "pnpm --recursive --if-present build",
    "audit": "pnpm audit --audit-level high",
    "db:up": "docker compose up --detach postgres",
    "db:wait": "docker compose up --detach --wait --wait-timeout 60 postgres",
    "db:up:local": "dotenv -e .env.local -- pnpm db:up",
    "db:wait:local": "dotenv -e .env.local -- pnpm db:wait",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down",
    "db:destroy-local-data": "docker compose down --volumes",
    "db:reset:test": "node tooling/database/reset-test-database.mjs",
    "db:reset:test:local": "dotenv -e .env.ci.local -- pnpm db:reset:test",
    "db:generate:local": "dotenv -e .env.local -- pnpm --filter @my-wallets/api prisma:generate",
    "db:validate:local": "dotenv -e .env.local -- pnpm --filter @my-wallets/api prisma:validate",
    "db:format:local": "dotenv -e .env.local -- pnpm --filter @my-wallets/api prisma:format",
    "db:migrate:dev:local": "dotenv -e .env.local -- pnpm --filter @my-wallets/api prisma:migrate:dev",
    "db:migrate:status:local": "dotenv -e .env.local -- pnpm --filter @my-wallets/api prisma:migrate:status",
    "db:studio:local": "dotenv -e .env.local -- pnpm --filter @my-wallets/api prisma:studio",
    "db:migrate:deploy": "pnpm --filter @my-wallets/api prisma:migrate:deploy",
    "test:database-safety": "node --test tooling/database/reset-test-database.test.mjs",
    "contracts:generate": "pnpm --filter @my-wallets/api generate:openapi && openapi-typescript packages/contracts/openapi.json -o apps/web/src/api/generated/openapi.d.ts",
    "contracts:check": "pnpm run contracts:generate && git diff --exit-code -- packages/contracts/openapi.json apps/web/src/api/generated/openapi.d.ts",
    "lint": "eslint .",
    "test:eslint-rules": "node --test tooling/eslint-rules/*.test.js",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "dotenv-cli": "11.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
