# API runtime and browser configuration. Keep server-only settings out of VITE_ variables.
NODE_ENV=development
# Optional public API origin for direct same-site subdomains; leave empty for the same-origin /api proxy.
VITE_API_BASE_URL=
API_HOST=127.0.0.1
PORT=3000
# Empty means same-origin/Vite-proxy use only; list exact origins for cross-origin hosting.
CORS_ALLOWED_ORIGINS=
# List only verified ingress IPs/CIDRs. Leave empty to ignore forwarded client-IP headers.
API_TRUSTED_PROXY_CIDRS=
# Enable only when public API traffic uses HTTPS at the ingress.
API_HTTPS_ENABLED=false
# Per-client request limit; health probes are exempt.
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_TIME_WINDOW_MS=60000
# Better Auth catch-all ceiling and authenticated-user ceiling share the same time window.
API_AUTH_RATE_LIMIT_MAX=60
API_AUTHENTICATED_RATE_LIMIT_MAX=300

# Local Compose PostgreSQL only. These credentials are not suitable outside loopback development.
POSTGRES_USER=wallet_local
POSTGRES_PASSWORD=wallet_local_only
POSTGRES_DB=wallet_dev
POSTGRES_PORT=5432

# Phase 2 API/Prisma development connection. In .env.ci.local, set NODE_ENV=test and use wallet_test.
DATABASE_URL=postgresql://wallet_local:wallet_local_only@127.0.0.1:5432/wallet_dev?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Phase 3 API-only Better Auth settings. Generate the local secret with `openssl rand -base64 32`.
# Required outside tests; use a distinct secret in each environment. URLs must be exact origins.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://localhost:5173
# Optional Google OAuth; both values enable the provider. Tests use mocked OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Better Auth limiter is always enabled in production; this opt-in is for controlled local tests.
BETTER_AUTH_RATE_LIMIT_ENABLED=false
BETTER_AUTH_RATE_LIMIT_MAX=100
BETTER_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
BETTER_AUTH_CREDENTIAL_RATE_LIMIT_MAX=5
BETTER_AUTH_CREDENTIAL_RATE_LIMIT_WINDOW_SECONDS=60

# Phase 5 API-only FMP settings. Obtain the key from the FMP account dashboard.
# Optional while provider features are unused; requests fail closed when absent. Tests use fakes.
# Put a real key only in ignored .env.local or the API secret manager; never use a VITE_ prefix.
FMP_API_KEY=
# Optional; default stable API base. Loopback HTTP is allowed for local fake providers only.
FMP_BASE_URL=https://financialmodelingprep.com/stable/
# Shared application-tracked budget. Development defaults; set both explicitly for production FMP.
FMP_DAILY_REQUEST_LIMIT=250
FMP_QUOTA_TIMEZONE=America/New_York
FMP_REFRESH_CONCURRENCY=3
