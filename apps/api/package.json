{
  "name": "@my-wallets/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && pnpm --filter @my-wallets/contracts build && tsc -p tsconfig.build.json",
    "start": "node dist/src/app.js",
    "dev": "pnpm build && pnpm start",
    "generate:openapi": "pnpm build && node dist/src/generate-openapi.js",
    "prisma:generate": "prisma generate && pnpm prisma:compile-client",
    "prisma:compile-client": "tsc --project tsconfig.prisma-client.json",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev && pnpm prisma:generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "test": "pnpm prisma:generate && pnpm --filter @my-wallets/contracts build && vitest run",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.7",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@my-wallets/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "p-limit": "^7.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "^8.23.1",
    "openapi-backend": "5.21.2",
    "prisma": "^7.10.0"
  }
}
