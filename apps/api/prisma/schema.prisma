generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CurrencyCode {
  USD
}

enum TransactionSide {
  BUY
  SELL
}

enum PriceSource {
  FMP
}

enum RefreshStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  wallets       Wallet[]

  @@unique([email])
  @@map("user")
}

model Wallet {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String                @db.VarChar(100)
  description          String?               @db.VarChar(500)
  reportingCurrency    CurrencyCode          @default(USD)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  transactions         LedgerTransaction[]
  refreshSubscriptions RefreshSubscription[]

  @@index([userId, createdAt, id])
  @@map("wallet")
}

model Instrument {
  symbol        String              @id @db.VarChar(40)
  name          String              @db.VarChar(300)
  exchange      String              @db.VarChar(100)
  quoteCurrency CurrencyCode
  transactions  LedgerTransaction[]

  @@map("instrument")
}

model LedgerTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  walletId        String          @db.Uuid
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  symbol          String          @db.VarChar(40)
  instrument      Instrument      @relation(fields: [symbol], references: [symbol], onDelete: Restrict)
  side            TransactionSide
  transactionDate DateTime        @db.Date
  quantity        Decimal         @db.Decimal(30, 8)
  unitPrice       Decimal         @db.Decimal(30, 8)
  currency        CurrencyCode
  description     String?         @db.VarChar(500)
  createdAt       DateTime        @default(now())

  @@index([walletId, symbol, transactionDate, createdAt, id])
  @@map("ledger_transaction")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model ProviderBudget {
  provider   String             @id @db.VarChar(50)
  dailyLimit Int
  timeZone   String             @db.VarChar(100)
  days       ProviderQuotaDay[]

  @@map("provider_budget")
}

model ProviderQuotaDay {
  provider  String         @db.VarChar(50)
  budget    ProviderBudget @relation(fields: [provider], references: [provider], onDelete: Restrict)
  quotaDate DateTime       @db.Date
  used      Int            @default(0)

  @@id([provider, quotaDate])
  @@map("provider_quota_day")
}

model PriceSnapshot {
  symbol      String       @db.VarChar(40)
  marketDate  DateTime     @db.Date
  unitPrice   Decimal      @db.Decimal(30, 8)
  currency    CurrencyCode
  source      PriceSource
  retrievedAt DateTime     @db.Timestamptz(3)

  @@id([symbol, marketDate])
  @@map("price_snapshot")
}

model RefreshWork {
  symbol          String                @id @db.VarChar(40)
  status          RefreshStatus         @default(PENDING)
  requestedAt     DateTime              @db.Timestamptz(3)
  updatedAt       DateTime              @db.Timestamptz(3)
  attempts        Int                   @default(0)
  leaseToken      String?               @db.Uuid
  leaseExpiresAt  DateTime?             @db.Timestamptz(3)
  nextAttemptAt   DateTime?             @db.Timestamptz(3)
  lastFailureCode String?               @db.VarChar(50)
  subscriptions   RefreshSubscription[]

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@map("refresh_work")
}

model RefreshSubscription {
  walletId String      @db.Uuid
  wallet   Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  symbol   String      @db.VarChar(40)
  work     RefreshWork @relation(fields: [symbol], references: [symbol], onDelete: Restrict)

  @@id([walletId, symbol])
  @@index([symbol])
  @@map("refresh_subscription")
}
