{
  "openapi": "3.1.0",
  "info": {
    "title": "My Wallet API",
    "description": "HTTP API for managing private investment wallets. Rate-limited responses include Retry-After, X-RateLimit-Limit, X-RateLimit-Remaining, and X-RateLimit-Reset headers.",
    "version": "1.0.0"
  },
