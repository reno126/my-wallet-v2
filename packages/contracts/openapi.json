              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "VALIDATION_FAILED",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "RATE_LIMITED",
                  "INTERNAL_SERVER_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requestId": {
                "$ref": "#/components/schemas/ResourceIdInput"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AuthSessionInput": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "$ref": "#/components/schemas/TimestampInput"
